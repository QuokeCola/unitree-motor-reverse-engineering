# Doxygen configuration for the API reference of all three interfaces.
# Run from the top of the repository:  doxygen docs/Doxyfile
# Output: docs/api/html/index.html (not tracked by git).

PROJECT_NAME           = "G1 joint motor SDK"
PROJECT_BRIEF          = "g1motor: unofficial drivers for Unitree G1 joint motors (Python, C++, MATLAB)"
OUTPUT_DIRECTORY       = docs/api
USE_MDFILE_AS_MAINPAGE = README.md

INPUT                  = README.md \
                         cpp/g1motor \
                         cpp/tests \
                         python/g1motor \
                         python/tests \
                         matlab \
                         docs/doxygen_matlab_filter.py
FILE_PATTERNS          = *.h *.cc *.py *.m *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */__pycache__/* */examples/*

# MATLAB is read through a small filter and treated as C++.
EXTENSION_MAPPING      = m=C++
FILTER_PATTERNS        = "*.m=python3 docs/doxygen_matlab_filter.py"
FILTER_SOURCE_FILES    = NO

# Python docstrings start with """! so that Doxygen commands are processed.
PYTHON_DOCSTRING       = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
SORT_MEMBER_DOCS       = NO
JAVADOC_AUTOBRIEF      = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
